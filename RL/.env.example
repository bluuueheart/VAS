# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Claude Configuration (Alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# System Configuration
MAX_RECURSION_DEPTH=10
MAX_ITERATIONS=15
ENABLE_STREAMING=false

# Memory Optimization (for multi-GPU/NPU environments)
# Lower these values if you encounter OOM errors
MAX_INPUT_TOKENS=4096
MAX_OUTPUT_TOKENS=1024
# PER_DEVICE_MAX_MEMORY_GB=20  # Uncomment and set to ~80-90% of your device memory

# Multi-Device Configuration
# NPU multi-device is enabled by default
# If you encounter OOM or device communication errors, try:
# FORCE_SINGLE_DEVICE=true              # Force single device
# PER_DEVICE_MAX_MEMORY_GB=18           # Limit per-device memory
# ENABLE_NPU_MULTI_DEVICE=false         # Disable NPU multi-device

# ========== Model Base Path Configuration ==========
# IMPORTANT: Only modify this ONE line to change all model paths
# All models will be located relative to this base directory
# Example: If your models are in /home/user/models/, set:
#   MODEL_BASE_PATH=/home/user/models
# Then the system will automatically find:
#   - Qwen models at: /home/user/models/Qwen/...
#   - CLAP model at: /home/user/models/laion/clap-htsat-fused
#   - etc.
MODEL_BASE_PATH=/home/ma-user/work/model

# Logging
LOG_LEVEL=INFO
LOG_FILE=toolrl.log
