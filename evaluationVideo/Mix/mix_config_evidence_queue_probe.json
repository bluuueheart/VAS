{
  "workspaces_root": "./workspaces_evidence_queue_probe",
  "progress_path": "./workspaces_evidence_queue_probe/mix_progress.json",
  "results_path": "./CFV_Evidence_queue_probe_result.json",
  "videomme_official_output_path": "./VideoMME_queue_probe_official_output.json",
  "shared_preprocess_root": "./workspaces_multi/_shared_cache",
  "ffmpeg_binary": "ffmpeg",
  "parallel_samples": 2,
  "allow_same_device_parallel": true,
  "accelerator_queue_enabled": true,
  "reuse_worker_samples": 1,
  "pipeline_options": {
    "mode": "react",
    "include_grounding_video_clip_qa": false
  },
  "dataset_order": [
    "lvbench",
    "videomme",
    "egoschema",
    "mlvu"
  ],
  "datasets": {
    "lvbench": {
      "enabled": true,
      "prompt_template_path": "./lvbench_query_prompt.txt",
      "dataset_root": "../../../../../data-1/datasets/LVBench",
      "annotation_path": "./data/train-00000-of-00001.parquet",
      "video_root": "./video_chunks",
      "allow_annotation_time_prior": false
    },
    "videomme": {
      "enabled": true,
      "prompt_template_path": "./videomme_query_prompt.txt",
      "subtitle_mode": "w/o sub.",
      "dataset_root": "../../../../../data-1/datasets/Video-MME",
      "annotation_path": "./videomme/test-00000-of-00001.parquet",
      "video_id_mapping_path": "./videomme/test-00000-of-00001.parquet",
      "video_search_roots": ["./data"],
      "video_extensions": [".mp4", ".mkv", ".webm", ".avi", ".mov"],
      "recursive_video_lookup": true,
      "include_durations": ["short", "medium", "long"]
    },
    "egoschema": {
      "enabled": true,
      "prompt_template_path": "./egoschema_query_prompt.txt",
      "dataset_root": "../../../../../data-1/datasets/egoschema",
      "annotation_path": "./Subset/test-00000-of-00001.parquet",
      "video_root": "./videos",
      "subset_name": "subset"
    },
    "mlvu": {
      "enabled": true,
      "prompt_template_path": "./mlvu_query_prompt.txt",
      "dataset_root": "../../../../../data-1/datasets/MLVU/MLVU",
      "annotation_root": "./json",
      "video_root": "./video"
    }
  }
}
